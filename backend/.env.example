# Sao chép file này thành ".env" và điền giá trị thật — KHÔNG commit ".env" thật vào git.

# Khóa bí mật dùng để ký JWT — đổi sang chuỗi ngẫu nhiên dài khi triển khai thật.
FINMIND_SECRET_KEY=doi-chuoi-nay-thanh-mot-khoa-bi-mat-ngau-nhien

# (Tùy chọn) Đường dẫn file CSDL SQLite. Để trống -> mặc định backend/chitieu.db.
# Dùng khi triển khai Docker để trỏ vào volume (xem docker-compose.yml).
# FINMIND_DB_PATH=/app/backend/data/chitieu.db

# ---- Cấu hình CSDL: SQLite (mặc định) hoặc SQL Server ----
# FINMIND_DB_ENGINE=sqlite (mặc định) -> dùng file SQLite ở trên.
# Đổi thành "sqlserver" để dùng Microsoft SQL Server cài trên máy (yêu cầu đã
# cài "ODBC Driver 17 for SQL Server" và thư viện pyodbc — xem requirements.txt).
# FINMIND_DB_ENGINE=sqlserver
# FINMIND_SQLSERVER_SERVER=localhost
# FINMIND_SQLSERVER_DATABASE=finmind_ai
# Để trống UID/PWD -> đăng nhập bằng Windows Authentication (tài khoản Windows
# đang đăng nhập). Chỉ điền UID/PWD nếu dùng SQL Server Authentication.
# FINMIND_SQLSERVER_UID=
# FINMIND_SQLSERVER_PWD=

# ---- Cấu hình AI ----
# AI_PROVIDER=ollama (mặc định) -> gọi Ollama chạy CỤC BỘ tại OLLAMA_URL.
# Nếu Ollama chưa cài/chưa bật, hệ thống tự động rơi về rule-engine nội bộ,
# không cần khóa API, ứng dụng vẫn chạy đầy đủ chức năng.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# (Tương lai) Muốn dùng OpenAI/Gemini/Claude/Hugging Face thay Ollama: đặt
# AI_PROVIDER tương ứng và thêm khóa API dưới đây — KHÔNG hardcode vào mã nguồn.
# AI_API_KEY=
